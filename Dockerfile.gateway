# Forge Gateway API Dockerfile
# 基于 Python 3.11 slim 镜像（优化版，减少构建时间）

FROM python:3.11-slim

WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# 安装系统依赖（添加 PostgreSQL 客户端库）
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq-dev \
    libasound2t64 \
    libatk-bridge2.0-0t64 \
    libatk1.0-0t64 \
    libatspi2.0-0t64 \
    libcairo2 \
    libcups2t64 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0t64 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libexpat1 \
    fonts-liberation \
    fontconfig \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 复制依赖文件
COPY requirements.txt .

# 依赖版本统一由 requirements.txt 管理。
RUN pip install --no-cache-dir -r requirements.txt

# 复制项目代码
COPY forge/ ./forge/
COPY migrations/ ./migrations/
COPY langgraph.json .

# 生产容器使用非 root 用户；密钥只通过运行时 Secret 注入。
RUN useradd --create-home --uid 10001 forge \
    && mkdir -p /app/output /ms-playwright \
    && python -m playwright install chromium \
    && chown -R forge:forge /app /ms-playwright

USER 10001:10001

# 暴露端口
EXPOSE 8000

# 启动 Gateway API
CMD ["uvicorn", "forge.gateway.app:app", "--host", "0.0.0.0", "--port", "8000"]
