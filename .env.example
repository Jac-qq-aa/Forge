# Forge Environment Configuration

# ============================================
# Qwen API 配置（用于所有模型调用）
# ============================================
QWEN_API_KEY=your-qwen-api-key
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================
# 模型配置（通过不同模型实现隔离）
# ============================================
# 改写模型（用于 Editor、Humanizer_Editor）
QWEN_MODEL=qwen3.7-max
ANTHROPIC_MODEL=qwen3.7-max
MILVUS_COLLECTION_NAME=ruibo_knowledge_v2
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_VECTOR_DIMENSION=1024

# 判断模型（用于 AI_Detector）
# 默认使用同一 Qwen 3.7 模型进行独立判断
JUDGE_MODEL=qwen3.7-max

# ============================================
# LangSmith 配置（工作流追踪和可视化）
# ============================================
# 在 https://smith.langchain.com 创建 API Key
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Forge-Content-Workflow

# ============================================
# AI 检测阈值配置
# ============================================
# AI率超过此值需要人性化改写（默认 0.7）
# 最大人性化改写次数（默认 3）

# ============================================
# HeyGen 配置（数字人视频生成）
# ============================================
# 在 https://www.heygen.com 注册并获取 API Key
# 免费试用可用，付费计划支持更多功能
HEYGEN_API_KEY=your-heygen-api-key

# ============================================
# PostgreSQL（异步任务与会话持久化）
# ============================================
PG_HOST=localhost
PG_PORT=5432
PG_USER=forge
PG_PASSWORD=change-me
PG_SSL=false
PG_DATABASE=forge
PG_POOL_MIN_SIZE=2
PG_POOL_MAX_SIZE=10
PG_STATEMENT_CACHE_SIZE=0

# ============================================
# 身份认证与租户配额
# ============================================
FORGE_JWT_SECRET=replace-with-at-least-32-random-bytes
FORGE_JWT_ISSUER=forge-auth
FORGE_JWT_AUDIENCE=forge-api
TENANT_SUBMISSIONS_PER_MINUTE=60
USER_SUBMISSIONS_PER_MINUTE=20
TENANT_MAX_ACTIVE_JOBS=10
USER_MAX_ACTIVE_JOBS=3
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=200
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_SSL=false

# ============================================
# RocketMQ 5.x 异步工作流
# ============================================
ROCKETMQ_ENDPOINTS=localhost:8081
ROCKETMQ_WORKFLOW_TOPIC=forge-workflow-jobs
ROCKETMQ_WORKFLOW_CONSUMER_GROUP=forge-workflow-workers
ROCKETMQ_GENERATION_TOPIC=forge-generation-tasks
ROCKETMQ_GENERATION_RETRY_TOPIC=forge-generation-retries
ROCKETMQ_GENERATION_CONSUMER_GROUP=forge-generation-workers
ROCKETMQ_GENERATION_QUEUE_COUNT=8
ROCKETMQ_BROKER_RETRY_MAX_TIMES=8
ROCKETMQ_ZHIHU_TOPIC=forge-zhihu-jobs
ROCKETMQ_ZHIHU_CONSUMER_GROUP=forge-zhihu-workers
JOB_CONSUMER_CONCURRENCY=4
JOB_CONSUMER_PREFETCH=0
JOB_LEASE_SECONDS=1800
JOB_MAX_ATTEMPTS=3
JOB_BUSY_RETRY_SECONDS=5
JOB_FAILURE_RETRY_SECONDS=10
GENERATION_WORKER_CONCURRENCY=4
GENERATION_EVENT_MAX_ATTEMPTS=3
LLM_TIMEOUT=180
GENERATION_TASK_TIMEOUT_SECONDS=7200
GENERATION_RETRY_BASE_SECONDS=15
GENERATION_RETRY_MAX_SECONDS=300
GENERATION_MAX_REVISION_ROUNDS=2
GENERATION_TOKEN_BUDGET=0
GENERATION_RECONCILE_INTERVAL_SECONDS=30
GENERATION_RECONCILE_BATCH_SIZE=100
LLM_MAX_ATTEMPTS=2
WORKER_SHUTDOWN_GRACE_SECONDS=100
JOB_RETENTION_DAYS=7
OUTBOX_RETENTION_HOURS=24

# 大任务结果：超过阈值后写入 S3 兼容对象存储
JOB_RESULT_S3_BUCKET=
JOB_RESULT_S3_PREFIX=workflow-results
JOB_RESULT_S3_ENDPOINT=
JOB_RESULT_INLINE_MAX_BYTES=65536
JOB_RESULT_MAX_READ_BYTES=16777216
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 容器日志与 Worker Prometheus 指标端口
LOG_FORMAT=json
LOG_LEVEL=INFO
METRICS_PORT=9100
METRICS_BEARER_TOKEN=
OUTBOX_PUBLISH_CONCURRENCY=16
OUTBOX_LOCK_SECONDS=120
OUTBOX_MAX_ATTEMPTS=10

# 知乎采集资源池
ZHIHU_JOB_CONCURRENCY=4
ZHIHU_BROWSER_POOL_SIZE=4
ZHIHU_GLOBAL_REQUESTS_PER_SECOND=0.5
ZHIHU_GLOBAL_BURST=2
ZHIHU_RESULT_CACHE_SECONDS=300
ZHIHU_REQUEST_DEDUP_SECONDS=30

# ============================================
# 阿里云 OSS 配置（数字人音频上传）
# ============================================
# 用于上传音频到公网 URL，供万相数字人 API 使用
# 在 https://oss.console.aliyun.com 创建 Bucket
OSS_BUCKET=your-bucket-name
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
