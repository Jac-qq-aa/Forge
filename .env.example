ENVIRONMENT=development
DATABASE_URL=postgresql://forge_app:forge_app@127.0.0.1:5432/forge
MIGRATION_DATABASE_URL=postgresql://forge_owner:forge_owner@127.0.0.1:5432/forge
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=forge
JWT_AUDIENCE=forge-api

LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-max
SKILL_ROUTER_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
LLM_TIMEOUT_SECONDS=180
# 应用预算，不代表供应商账号配额。多个进程共享同一 Redis。
REDIS_URL=redis://127.0.0.1:6379/0
MODEL_MAIN_RPM=20
MODEL_MAIN_TPM=100000
MODEL_MAIN_CONCURRENCY=3
MODEL_ROUTER_RPM=30
MODEL_ROUTER_TPM=30000
MODEL_ROUTER_CONCURRENCY=2
MODEL_EMBEDDING_RPM=30
MODEL_EMBEDDING_TPM=60000
MODEL_EMBEDDING_CONCURRENCY=2
MODEL_LIMIT_WAIT_SECONDS=180
MODEL_MAX_OUTPUT_TOKENS=4096
GRAPH_MAX_CONCURRENCY=3
METRICS_PORT=9001
GRAFANA_ADMIN_PASSWORD=forge-local-admin

TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
CRITIC_MAX_FAILURES=3
SQL_TIMEOUT_MS=5000
SQL_RESULT_LIMIT=100
SKILL_ROOT=skills/company_knowledge
ARTICLE_SKILL_ROOT=skills/article_types
ARTICLE_FACTS_SKILL_ROOT=skills/article_facts
# Consumer 在基础设施异常时最多重试三次；critic 的三次不通过单独计数。
CONSUMER_MAX_ATTEMPTS=3

LANGGRAPH_SERVER_URL=http://127.0.0.1:8123
LANGGRAPH_ASSISTANT_ID=forge
LANGGRAPH_RECONCILE_SECONDS=1

ROCKETMQ_BRIDGE_URL=http://127.0.0.1:8090
ROCKETMQ_BRIDGE_TOKEN=replace-with-bridge-token
ROCKETMQ_CONSUMER_SECRET=replace-with-consumer-secret
ROCKETMQ_INDEX_CONSUMER_SECRET=replace-with-index-consumer-secret
ROCKETMQ_AUDIT_CONSUMER_SECRET=replace-with-audit-consumer-secret
CONSUMER_KIND=start
INDEX_MAX_CONCURRENCY=1
AUDIT_MAX_CONCURRENCY=1
ROCKETMQ_PUBLISH_TIMEOUT_SECONDS=10
OUTBOX_POLL_SECONDS=0.5
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=3
TRACE_RETENTION_DAYS=30
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=forge
