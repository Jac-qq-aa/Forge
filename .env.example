# Forge Environment Configuration

# ============================================
# Qwen API 配置（用于所有模型调用）
# ============================================
QWEN_API_KEY=your-qwen-api-key

# ============================================
# 模型配置（通过不同模型实现隔离）
# ============================================
# 改写模型（用于 Editor、Humanizer_Editor）
QWEN_MODEL=qwen-plus

# 判断模型（用于 AI_Detector）
# 使用更强的模型进行独立判断，确保客观性
# 可选: qwen-max（最强）、qwen-long（长文本）、qwen-turbo（快速）
JUDGE_MODEL=qwen-max

# ============================================
# LangSmith 配置（工作流追踪和可视化）
# ============================================
# 在 https://smith.langchain.com 创建 API Key
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Forge-Content-Workflow

# ============================================
# AI 检测阈值配置
# ============================================
# AI率超过此值需要人性化改写（默认 0.7）
AI_THRESHOLD=0.7
# 最大人性化改写次数（默认 3）
MAX_HUMANIZE_REVISIONS=3

# ============================================
# HeyGen 配置（数字人视频生成）
# ============================================
# 在 https://www.heygen.com 注册并获取 API Key
# 免费试用可用，付费计划支持更多功能
HEYGEN_API_KEY=your-heygen-api-key

# ============================================
# 阿里云 OSS 配置（数字人音频上传）
# ============================================
# 用于上传音频到公网 URL，供万相数字人 API 使用
# 在 https://oss.console.aliyun.com 创建 Bucket
OSS_BUCKET=your-bucket-name
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret